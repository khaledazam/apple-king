# ==============================================================================
# APPLE KING ONLINE STOREFRONT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT:
# - This application runs independently in the cloud (Vercel, Railway, VPS, etc.).
# - It connects directly to MongoDB Atlas using a dedicated, read-only database user.
# - DO NOT USE the local ERP backend connection string or administrative Atlas credentials.
# - Never commit production secrets to version control.
# ==============================================================================

# [MANDATORY] Dedicated Read-Only Connection String
# Scoped strictly to database `erp_phones` and collection `storefrontproducts` with `find` privilege only.
STOREFRONT_MONGODB_URI=mongodb+srv://<READ_ONLY_USER>:<PASSWORD>@cluster0.xiz8ric.mongodb.net/erp_phones?retryWrites=true&w=majority

# [MANDATORY] Database Name (authoritative verified: erp_phones)
STOREFRONT_DB_NAME=erp_phones

# [MANDATORY] Target Collection Name (authoritative verified: storefrontproducts)
STOREFRONT_COLLECTION_NAME=storefrontproducts

# [PUBLIC] Brand Storefront Name
NEXT_PUBLIC_STORE_NAME=APPLE KING

# [PUBLIC] Official Customer WhatsApp Inquiry Number (E.164 format without '+' or spaces, e.g., 201012345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=<OFFICIAL_EGYPTIAN_NUMBER>

# [PUBLIC] Public Storefront Canonical Domain
NEXT_PUBLIC_APP_URL=<VERIFIED_PUBLIC_URL>

# Node Environment
NODE_ENV=production
